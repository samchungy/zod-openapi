    "rootDir": ".",
    "lib": ["ES2023"],
    "outDir": "lib",
    "removeComments": false,
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": ["zod-openapi/source"],
    "skipLibCheck": true
